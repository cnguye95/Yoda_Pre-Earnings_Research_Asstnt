# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# OpenAI: filing embeddings (text-embedding-3-small) and the eval judge (gpt-6.1-sol)
OPENAI_API_KEY=

# Anthropic: all report generation — Claude Sonnet 5.5 (synthesis, critique, baseline)
# and Claude Haiku 5.5 (personality tool loops)
ANTHROPIC_API_KEY=

# Finnhub: analyst consensus estimates (price, market cap, earnings calendar)
FINNHUB_API_KEY=

# Financial Modeling Prep: EPS and revenue estimates (Finnhub free-tier backup)
FMP_API_KEY=

# Tavily: news and web search
TAVILY_API_KEY=

# Alpha Vantage: earnings call transcripts (free key: https://www.alphavantage.co/support/#api-key;
# the free plan allows about 25 requests a day, and transcripts are cached on disk)
ALPHAVANTAGE_API_KEY=

# SEC EDGAR requires a real contact string in the User-Agent header.
# Format: "Your Name your.email@example.com"
SEC_USER_AGENT=Your Name your.email@example.com

